{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?path=api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "/api/index.py?path=health/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
